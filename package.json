{
  "name": "kinderguard",
  "version": "0.2.3",
  "private": true,
  "description": "KinderGuard desktop app for managing daycare branches and permit renewals.",
  "main": "electron/main.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "electron": "electron .",
    "dist": "electron-builder",
    "check": "node --check src/server.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.392.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "electron-updater": "^6.8.11",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.0",
    "express-validator": "^7.0.1",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^7.7.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "winston": "^3.10.0"
  },
  "devDependencies": {
    "aws-sdk-client-mock": "^4.1.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "jsdom": "^31.0.0",
    "mongodb-memory-server": "^11.2.0",
    "nodemon": "^3.0.1",
    "supertest": "^7.2.2",
    "vitest": "^4.1.8"
  },
  "build": {
    "productName": "KinderGuard",
    "appId": "com.kinderguard.desktop",
    "files": [
      "**/*",
      "!.env",
      "!**/.env",
      "!node_modules/*/{CHANGELOG.md,README.md,README,readme.md,readme}",
      "!**/test/**",
      "!**/*.md"
    ],
    "directories": {
      "buildResources": "build"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.business"
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ]
    },
    "publish": [
      {
        "provider": "github",
        "owner": "I-L9614",
        "repo": "KinderGuard",
        "releaseType": "release"
      }
    ]
  },
  "overrides": {
    "minimatch": "^11.0.5",
    "@electron/universal": "^3.0.6",
    "glob": "^14.0.4"
  }
}
